#include <env/tq/em/mmcboot.env>
#include <env/tq/em/rauc.env>

bootfile=Image.gz
fdtfile=k3-am625-em-cb30.dtb
/* loadaddr defaults to 0x82000000 */
kernel_addr_r=0x86000000
fdt_addr_r=0x81000000

boot_image=
	unzip ${loadaddr} ${kernel_addr_r} &&
	fdt addr ${fdt_addr_r} &&
	fdt resize &&
	kaslrseed &&
	booti ${kernel_addr_r} - ${fdt_addr_r}

raucboot=run raucinit && run mmcboot; reset
simpleboot=setenv rauc_slot 1 && run mmcboot
bootcmd=run raucboot

dfu_alt_info_ram=
	tispl.bin ram 0x80080000 0x200000;
	u-boot.img ram 0x81000000 0x400000
dfu_alt_info=
	emmc raw 0 0x800000 mmcpart 0;
	boot.raw raw 0x0 0x2000 mmcpart 1;
	tiboot3.bin.raw raw 0x0 0x400 mmcpart 1;
	tispl.bin.raw raw 0x400 0xc000 mmcpart 1;
	u-boot.img.raw raw 0x1000 0x1000 mmcpart 1
