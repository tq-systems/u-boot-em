kernel_addr_r=0x84000000
fdt_addr_r=0x88000000

bootargs=
	console=ttyS0,115200
	root=/dev/mmcblk0p2 rw rootwait
bootcmd=
	load mmc 0:2 $loadaddr /boot/Image.gz &&
	unzip $loadaddr $kernel_addr_r &&
	load mmc 0:2 $fdt_addr_r /boot/k3-am625-em-cb30.dtb &&
	fdt addr $fdt_addr_r &&
	fdt resize &&
	kaslrseed &&
	booti $kernel_addr_r - $fdt_addr_r

dfu_alt_info_ram=
	tispl.bin ram 0x80080000 0x200000;
	u-boot.img ram 0x81000000 0x400000
dfu_alt_info=
	emmc raw 0 0x800000 mmcpart 0;
	boot.raw raw 0x0 0x2000 mmcpart 1;
	tiboot3.bin.raw raw 0x0 0x400 mmcpart 1;
	tispl.bin.raw raw 0x400 0xc000 mmcpart 1;
	u-boot.img.raw raw 0x1000 0x1000 mmcpart 1
