raucinit=
	test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "1 2";
	test -n "${BOOT_1_LEFT}" || setenv BOOT_1_LEFT 3;
	test -n "${BOOT_2_LEFT}" || setenv BOOT_2_LEFT 3;

	setenv boot_slot;
	for try_slot in "${BOOT_ORDER}"; do
		if test "x${boot_slot}" != "x"; then
			true skip remaining slots;
		elif test "x${try_slot}" = "x1"; then
			if test 0x${BOOT_1_LEFT} -gt 0; then
				echo "Found valid slot 1, ${BOOT_1_LEFT} attempts remaining";
				setexpr BOOT_1_LEFT ${BOOT_1_LEFT} - 1;
				setenv boot_slot 1;
			fi;
		elif test "x${try_slot}" = "x2"; then
			if test 0x${BOOT_2_LEFT} -gt 0; then
				echo "Found valid slot 2, ${BOOT_2_LEFT} attempts remaining";
				setexpr BOOT_2_LEFT ${BOOT_2_LEFT} - 1;
				setenv boot_slot 2;
			fi;
		fi;
	done;

	if test -n "${boot_slot}"; then
		saveenv;
	else
		echo "No valid slot found, resetting tries to 3";
		setenv BOOT_1_LEFT 3;
		setenv BOOT_2_LEFT 3;
		saveenv;
		reset;
	fi
