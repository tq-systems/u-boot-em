stdin=serial
stdout=serial
stderr=serial

nc_on=
	setenv ncip ${serverip};
	setenv stdin serial,nc;
	setenv stdout serial,nc;
	setenv stderr serial,nc;
	echo "Started netconsole"
nc_off=
	echo "Stopping netconsole";
	setenv stdin serial;
	setenv stdout serial;
	setenv stderr serial;
	setenv ncip

get_cmd=tftp
boot_net_prefix=em-cb30

load_kernel_net=${get_cmd} ${loadaddr} ${boot_net_prefix}/${bootfile}
load_fdt_net=${get_cmd} ${fdt_addr_r} ${boot_net_prefix}/${fdtfile}

boot_net=
	echo "Booting from net" &&
	setenv bootargs "${bootargs_extra}" &&
	run load_kernel_net &&
	run load_fdt_net &&
	echo "Loaded kernel and device tree via tftp" &&
	run boot_image
