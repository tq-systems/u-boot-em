set_boot_part_1=
	setenv boot_part 2
set_boot_part_2=
	setenv boot_part 3

mmcboot=
	echo "Booting from MMC" &&
	run set_boot_part_${boot_slot} &&
	setenv bootargs "root=/dev/mmcblk0p${boot_part} rw rootwait
		rauc.slot=${boot_slot}
		${bootargs_extra}" &&
	load mmc 0:${boot_part} ${loadaddr} "/boot/${bootfile}" &&
	load mmc 0:${boot_part} ${fdt_addr_r} "/boot/${fdtfile}" &&
	run boot_image
